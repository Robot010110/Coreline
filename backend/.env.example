# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/teammart?schema=public"

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Port the API listens on.
PORT=4000

# development | production
NODE_ENV=development

# Comma-separated allowlist of origins allowed to call this API
# (e.g. "https://app.coreline.com,https://admin.coreline.com"). Leave
# unset in development — the API allows any origin so the Vite dev server
# works with zero setup. Set this before deploying to production.
CORS_ORIGIN=

# Base URL uploaded-file links are built from (e.g.
# "https://api.coreline.com"). Leave unset in development — it falls
# back to the request's own protocol+host, which is correct for
# localhost. Set this in production if the API sits behind a proxy/load
# balancer that changes what the app sees as its own host.
PUBLIC_BASE_URL=

# Admin Phase 1 §2 — real Admin account provisioning (npm run
# admin:provision). Only the two *_PASSWORD variables are required; name/
# email fall back to the two intended accounts if unset. Never commit
# real values here — set them in your local .env or your deployment
# platform's secret store only.
ADMIN_1_NAME="Raxand ENVy"
ADMIN_1_EMAIL="raxand.envy@teammart.admin"
ADMIN_1_PASSWORD=
ADMIN_2_NAME="MoNReaL pride"
ADMIN_2_EMAIL="monreal.pride@teammart.admin"
ADMIN_2_PASSWORD=

# Optional: a separate database for `npm test` (backend/test/security)
# to use instead of DATABASE_URL, e.g.
#   postgresql://user:password@localhost:5432/teammart_test
# Leave unset to run the test suite against your normal dev database —
# it's safe to do so (every row it creates is tagged and deleted again),
# but a dedicated test database gives real isolation if you'd prefer it.
TEST_DATABASE_URL=

# Scratch database Prisma uses to diff migrations. MUST be a separate,
# disposable database — never the application database, which Prisma
# would drop and recreate.
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/teammart_shadow?schema=public"

# Supervisor and Zone Manager (Regional Manager) sign in with NO User ID and
# NO password — tapping the role on the login screen enters directly as the
# seeded Supervisor / Zone Manager account. Anyone who can reach the app can
# do this, so set it to "false" once real accounts with their own
# credentials exist. Defaults to enabled when unset.
OPEN_ROLE_LOGIN=true

# Credentials the seed (npm run prisma:seed) creates the Admin, Worker and
# Cashier accounts with. All optional; the seed never overwrites an
# existing account's password.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_WORKER_USERNAME=
SEED_WORKER_PASSWORD=
SEED_CASHIER_USERNAME=
SEED_CASHIER_PASSWORD=
